# ─────────────────────────────────────────────────────────────────────────────
# سامانه مدیریت کلینیک زیبایی — environment template
#
# Copy to .env and fill in the values:
#
#     cp .env.example .env
#
# .env is gitignored and must NEVER be committed.
# This file carries variable NAMES and shapes only — never a real value.
#
# Every variable is parsed once at startup by a Zod schema. A missing or
# malformed value fails the boot with a named error, rather than failing later
# at the point of use. See docs/setup/installation.md §4.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ─────────────────────────────────────────────────────────────────
# Development uses SQLite: a file, no server to install.
# The SQLite file is gitignored — never commit a database file.
DATABASE_URL="file:./dev.db"

# Production uses PostgreSQL. Required in production, ignored in development.
# ROW-LEVEL SECURITY IS REQUIRED IN PRODUCTION. A production boot against
# SQLite refuses to start, and so does a boot with RLS disabled on a
# tenant-scoped table. See docs/setup/database-migration.md §4.
# The tenant context is applied per transaction with:
#     SELECT set_config('app.tenant_id', $1, true);
# — never SET LOCAL, which cannot take a bind parameter and would require
# interpolating the tenant id into SQL text.
DATABASE_URL_PRODUCTION=""


# ── Tenancy ──────────────────────────────────────────────────────────────────
# true  → SaaS: many tenants in one installation, with a tenant switcher.
# false → On-premise: one clinic. Requires LICENSE_KEY.
#
# This flag gates TWO things only: whether the tenant switcher renders, and
# whether the tenant-management and license route trees are reachable.
# The schema, the migrations and the loaded modules are identical in both
# modes. No module branches on this value. See docs/setup/single-tenant.md.
MULTI_TENANT="true"


# ── Authentication ───────────────────────────────────────────────────────────
# Signs the session cookie. Must be at least 32 characters, and must be UNIQUE
# PER INSTALLATION — a shared secret means sessions are valid across installs.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Rotating this value invalidates every session. It is a planned action.
NEXTAUTH_SECRET=""


# ── Gateways ─────────────────────────────────────────────────────────────────
# SMS gateway — used by the seven automatic messages and by campaigns.
# Use the sandbox key in development. Never log this value.
SMS_PROVIDER_KEY=""

# Payment gateway — used for booking deposits and online debt payment.
# Use the sandbox key in development. Never log this value.
PAYMENT_PROVIDER_KEY=""


# ── Licence ──────────────────────────────────────────────────────────────────
# Required only when MULTI_TENANT=false. Ignored when MULTI_TENANT=true.
#
# The key is validated locally, with the vendor's public key. NO NETWORK CALL
# IS REQUIRED for the product to run — an on-premise server may have no
# reliable internet, and a licence check that needs one would take the product
# down when the clinic's connection drops.
#
# An EXPIRED licence does not stop the product. It shows a notice to managers,
# blocks new invitations beyond the seat limit, and blocks upgrades. Booking,
# cycles, messages, payments, reports, the customer panel and the worker's jobs
# all keep running — a clinic's patients are not a party to its licence.
# See docs/setup/licensing.md §4.
LICENSE_KEY=""


# ── Runtime ──────────────────────────────────────────────────────────────────
# development | test | production
# "production" enforces the boot checks above.
NODE_ENV="development"

# error | warn | info | debug
# Never "debug" in production: application logs must contain no PII, and debug
# logging is where identifiers of people tend to leak.
LOG_LEVEL="info"

# The public origin, used for absolute URLs in messages and for cookie scope.
# No trailing slash.
APP_URL="http://localhost:3000"


# ── Worker ───────────────────────────────────────────────────────────────────
# How long a claimed job may run before its claim expires and another worker
# may take it. A killed worker's jobs recover after this window.
WORKER_CLAIM_TIMEOUT_MS="300000"

# How often the worker polls for due jobs, in milliseconds.
WORKER_POLL_INTERVAL_MS="30000"


# ─────────────────────────────────────────────────────────────────────────────
# Not configured here, deliberately:
#
#   • The clinic's identity, working hours, cycle defaults, message text and
#     the 8 behavioral toggles. These are per-tenant settings, configured by
#     the clinic in admin/settings.html — not deployment configuration.
#
#   • The design system's tokens. Those are committed source values in
#     docs/knowledge/08-ui-design-system.md §46, not environment variables.
#
#   • The Jalali calendar. Computed in-house, with no runtime configuration,
#     so that a date renders identically on every machine.
# ─────────────────────────────────────────────────────────────────────────────
