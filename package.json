{
  "name": "clinic",
  "version": "0.1.0",
  "private": true,
  "description": "Persian clinic management platform — appointments, treatment cycles, campaigns, debts and reporting for a single clinic or a multi-branch tenant.",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:pg": "node scripts/db-migrate-pg.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:provider": "node scripts/db-provider.mjs",
    "check:files": "node scripts/check-file-length.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:overrides": "node scripts/check-overrides.mjs",
    "check:schema": "node scripts/check-schema-portability.mjs",
    "check:rls": "node scripts/check-rls-coverage.mjs",
    "verify": "npm run db:generate && npm run typecheck && npm run lint && npm run check:files && npm run check:i18n && npm run check:overrides && npm run check:schema && npm run check:rls && npm run test"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.104.0",
    "cmdk": "1.1.1",
    "date-fns-jalali": "4.4.0-0",
    "framer-motion": "13.5.0",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "vazirmatn": "^33.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.3"
  }
}
